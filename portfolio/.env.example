# PostHog analytics
# Copy this file to .env.local and fill in your values (.env.local is gitignored).
# Get these from your PostHog project: Settings -> Project -> Project API Key.

# Project API Key (public, safe to expose client-side). Starts with "phc_".
VITE_PUBLIC_POSTHOG_KEY=

# Region host: US = https://us.i.posthog.com  ·  EU = https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
